# DeadByte environment variables — copy to .env.local and fill in.
# Leave ALL account values empty to run in demo mode.
# Setting only SOME of them puts the app in "misconfigured" mode (fail closed).

# Public: safe to expose in the browser
# Used for auth email links (sign-up confirmation / password reset). Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: NEVER prefix these with NEXT_PUBLIC_
# Supabase "secret" API key (sb_secret_...). Used only by server code and operator scripts.
SUPABASE_SECRET_KEY=
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Rotating it invalidates all stored flag digests
# (every flag must be re-entered in the admin UI after a rotation).
FLAG_HMAC_SECRET=
# Optional: per-user flag submissions per rolling minute (default 10). Enforced in the database.
FLAG_SUBMISSIONS_PER_MINUTE=

# Phase 3 (evidence storage, Cloudflare R2) — not required for accounts and scoring. See docs/r2-setup.md.
# Partial/invalid values only disable downloads. Use a token scoped to this environment's bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deadbyte-evidence-dev
# Optional: signed download URL lifetime in seconds, 300-900 (default 600).
EVIDENCE_URL_TTL_SECONDS=
# Optional: download links per player per rolling hour (default 30). Enforced in the database.
EVIDENCE_GRANTS_PER_HOUR=

# Reserved for a future distributed limiter. Not used: submission and download
# limits are enforced atomically in Postgres, which is shared across serverless instances.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
