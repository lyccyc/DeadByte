# DeadByte environment variables — copy to .env.local and fill in.
# Leave ALL backend values empty to run in demo mode.
# Setting only SOME of them puts the app in "misconfigured" mode (fail closed).

# Public: safe to expose in the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Rotating it invalidates all stored flag digests.
FLAG_HMAC_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deadbyte-evidence-dev

# Optional distributed rate limiter for deployment (Phase 2)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
